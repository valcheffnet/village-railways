{
	"schemaVersion": 1,
	"id": "village_railways",
	"version": "${version}",
	"name": "Village Railways",
	"description": "Links villages with minecart railway lines built from vanilla blocks. Works in singleplayer, and on a server, where vanilla clients can join without the mod.",
	"authors": [
		"SasnycoN"
	],
	"license": "All Rights Reserved",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.valcheff.villagerailways.fabric.FabricEntry"
		],
		"client": [
			"net.valcheff.villagerailways.client.fabric.FabricClientEntry"
		],
		"modmenu": [
			"net.valcheff.villagerailways.client.fabric.ModMenuIntegration"
		]
	},
	"mixins": [
		"village_railways.mixins.json",
		{
			"config": "village_railways.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": "*",
		"minecraft": "~26.1",
		"java": ">=${java_version}"
	},
	"suggests": {
		"modmenu": "*"
	}
}
